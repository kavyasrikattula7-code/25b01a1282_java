    public static void bubbleSort(int[] arr) {
        int n = arr.length;
        
        for (int i=0;i&lt;n;i++){
			for(int j=i+1;j&lt;n;j++){
				if (arr[i]&gt;arr[j]){
					int temp=arr[i];
					arr[i]=arr[j];
