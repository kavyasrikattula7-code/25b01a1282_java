class MsgPrinter implements Runnable{
	private String msg;
	MsgPrinter(String msg){
		this.msg=msg;
	}
	public void run(){
		try{
			for(int i=0;i&lt;5;i++){
				System.out.println(msg);
				Thread.sleep(500);
			}
		}
		catch(InterruptedException ie){
			System.out.println("Thread Interrupted:"+msg);
		}
	}
}
