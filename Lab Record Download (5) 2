		this.name=name;
	}
	void displayData(){
		System.out.println("Id : "+id);
		System.out.println("Name : "+name);
	}
}
class Marks extends Student{
	float javaMarks;
	float cMarks;
	float cppMarks;
	void setMarks(float javaMarks,float cMarks,float cppMarks){
		this.javaMarks=javaMarks;
		this.cMarks=cMarks;
