class WorkerThread extends Thread {
	private int threadId;
	WorkerThread(int id){
		threadId=id;
	}
	public void run(){
		System.out.println("Thread "+threadId+" started");
		try{
			for(int i=0;i&lt;2;i++){
				Thread.sleep(200);
			}
			System.out.println("Thread "+threadId+" finished");
		}
		catch(InterruptedException e){
			System.out.println("Thread"+threadId+"interrupted:"+e);
		}
	}
}
public class DaemonThread {
	public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the number of user threads: ");
        int numUserThreads = scanner.nextInt();

        System.out.print("Enter the number of daemon threads: ");
        int numDaemonThreads = scanner.nextInt();
		int id=1;
		for(int i=0;i&lt;numUserThreads;i++){
			WorkerThread userThreads=new WorkerThread(id++);
			userThreads.start();
		}
		id=1;
		for(int i=0;i&lt;numDaemonThreads;i++){
			WorkerThread daemonThread=new WorkerThread(id++);
			daemonThread.setDaemon(true);
			daemonThread.start();
		}
