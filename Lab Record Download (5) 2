		System.out.println("C marks : "+ cMarks);
		System.out.println("Cpp marks : " + cppMarks);
	}
}
class Result extends Marks{
	float total;
	float avg;
	void compute(){
		total=javaMarks+cMarks+cppMarks;
		avg=total/3;
	}
	void showResult(){
		System.out.println("Total : "+total);
		System.out.println("Avg : "+avg);
	}
}
