	double radius;

	Circle(double radius){
		this.radius = radius;
	}

	@Override
	double calculateArea(){
		return Math.PI * radius * radius;
	}
}

class Square extends Shape{
	double side;

	Square(double side){
		this.side = side;
	}

	@Override
	double calculateArea(){
		return side * side;
	}
}

