class MsgPrinter implements Runnable{
	private String msg;
	MsgPrinter(String msg){
		this.msg=msg;
	}
	public void run(){
		try{
			for(int i=0;i&lt;5;i++){
				System.out.println(msg);
				Thread.sleep(500);
			}
		}
		catch(InterruptedException ie){
			System.out.println("Thread Interrupted:"+msg);
		}
	}
}
class MyThread{
	public static void main(String args[]){
		Thread t1=new Thread(new MsgPrinter("Good Morning"));
		Thread t2=new Thread(new MsgPrinter("Hello"));
		Thread t3=new Thread(new MsgPrinter("Welcome"));
		t1.start();
		t2.start();
		t3.start();
	}
}


